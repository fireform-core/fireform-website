<style id="sccss">/* TEMP FIX (raknight, 2025-04-18) */
.wp-site-blocks {
    grid-template-columns: 100%;
}	
	
/* Key Takeaways Pattern Styles */
.ucsc-key-takeaways ul {
	list-style-type: square;
	margin: 0.5em 0 0.5em -1rem;
}

.ucsc-key-takeaways ul li {
	margin-bottom: .8em;
}

.ucsc-key-takeaways ul li::marker {
	color: var(--wp--preset--color--ucsc-rubine-blue);

}

/*
 * Explore Stories by Topic Styles
 */

.ucsc-explore-stories__heading {
		align-items: center;
    display: flex;
    margin-bottom: var(--wp--preset--spacing--30);
}

.ucsc-explore-stories__heading::before {
    aspect-ratio: 1;
    background-color: var(--wp--preset--color--ucsc-pacific-blue);
    content: "";
    height: .65em;
    margin-right: .44em;
}

.ucsc-explore-stories__title {
    font-weight: 700;
    font-size: var(--wp--preset--font-size--three);
    line-height: var(--wp--custom--line-height--medium);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--ucsc-medium-gray);
}
.ucsc-explore-stories__title a {
    text-decoration: none;
}

.ucsc-explore-stories__title a:hover {
    -webkit-text-decoration-skip: ink;
    color: var(--wp--preset--color--ucsc-secondary-blue);
    text-decoration: underline;
    text-decoration-color: var(--wp--preset--color--ucsc-primary-yellow);
    text-decoration-skip-ink: auto;
    text-decoration-thickness: .12rem;
    text-underline-offset: .12em;
}
.ucsc-explore-stories__date {
    font-size: var(--wp--preset--font-size--base);
    font-weight: 700;
    padding-top: 0.5rem;
}

@media (max-width: 768px) {
		.fwpl-row.el-8cjrpw {
    grid-template-columns: 1fr !important;
}
}

.ucsc-explore-stories__featured-image img {
	max-width: 100%;
	height: auto;
}

/*
 * All News Archive Category Styles
 */

.ucsc-all-news-category a {
		color: var(--wp--preset--color--ucsc-secondary-blue);
		text-decoration: none;
	
}

.ucsc-all-news-category a:hover {
		-webkit-text-decoration-skip: ink;
		color: var(--wp--preset--color--ucsc-primary-blue);
		text-decoration: underline;
		text-decoration-color: var(--wp--preset--color--ucsc-primary-yellow);
		text-decoration-skip-ink: auto;
		text-decoration-thickness: .12rem;
		text-underline-offset: .12em;
}

.clear {
	clear: both !important;
}</style></head>

